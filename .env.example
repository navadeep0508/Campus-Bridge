# Generate a unique value with: py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Optional; defaults to ./campus_bridge.db
# DATABASE_PATH=./campus_bridge.db

# Set both to use Supabase instead of local SQLite. Keep the service-role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations. Related features remain unavailable when blank.
JUDGE0_API_KEY=
# Groq powers the in-app AI assistant, career recommendations, and code review.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback if Groq is not configured.
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026
GEMINI_API_KEY=

# Set true for HTTPS deployments; keep false for local HTTP development.
COOKIE_SECURE=false

# Demo seeding is opt-in. DEMO_PASSWORD must contain at least 12 characters.
SEED_DEMO_DATA=false
DEMO_PASSWORD=
